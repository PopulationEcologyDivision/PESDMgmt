getDistributionGroupMembers <- function(group_email = "DFO.RMARSciencePEDISAR-ScienceIEPDEPCMARR.MPO@dfo-mpo.gc.ca") {
site <- Microsoft365R::get_sharepoint_site(site_url = "https://086gc.sharepoint.com/sites/msteams_74c888-ManagementTeam")
token <- site$token$credentials$access_token
# Step 1: Get group ID
resp <- httr::GET(
"https://graph.microsoft.com/v1.0/groups",
httr::add_headers(Authorization = paste("Bearer", token)),
httr::accept_json(),
query = list(`$filter` = paste0("mail eq '", group_email, "'"))
)
httr::stop_for_status(resp)
group_id <- httr::content(resp, as = "parsed", simplifyVector = TRUE)$value$id
# Step 2: Get members
resp2 <- httr::GET(
sprintf("https://graph.microsoft.com/v1.0/groups/%s/members?$select=displayName,mail", group_id),
httr::add_headers(Authorization = paste("Bearer", token)),
httr::accept_json()
)
httr::stop_for_status(resp2)
httr::content(resp2, as = "parsed", simplifyVector = TRUE)
}
