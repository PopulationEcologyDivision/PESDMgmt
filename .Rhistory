auditPESDStaffLists <- function(permissions, mailing_lists, site_members) {
# Extract and clean emails from each source
emails_permissions <- tolower(
sub("i:0#.f\\|membership\\|", "", permissions$EmployeeName.Claims)
)
emails_mailing <- tolower(mailing_lists$mail)
emails_site <- tolower(site_members$mail)
# Unified vector of all unique emails across all sources
all_emails <- unique(c(emails_permissions, emails_mailing, emails_site))
# setdiff against each source
missing_from_mailing      <- setdiff(all_emails, emails_mailing)
missing_from_site         <- setdiff(all_emails, emails_site)
missing_from_permissions  <- setdiff(all_emails, emails_permissions)
# Report
cat("Missing from mailing lists:\n")
cat(paste0("  ", seq_along(missing_from_mailing), ") ", missing_from_mailing, "\n"))
cat("\nMissing from SharePoint site membership:\n")
cat(paste0("  ", seq_along(missing_from_site), ") ", missing_from_site, "\n"))
cat("\nMissing from permissions list:\n")
cat(paste0("  ", seq_along(missing_from_permissions), ") ", missing_from_permissions, "\n"))
# Return invisibly for further use if needed
invisible(list(
missing_from_mailing     = missing_from_mailing,
missing_from_site        = missing_from_site,
missing_from_permissions = missing_from_permissions
))
}
# Usage:
audit <- auditPESDStaffLists(
permissions   = PESDPermissionsListCSV,
mailing_lists = PESDMailingLists,
site_members  = SharepointSiteMembers
)
